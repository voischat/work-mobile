{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "ESLint": {
      "type": "local",
      "command": ["npx", "@eslint/mcp@latest"],
      "enabled": true
    }
  },
  "formatter": {
    "eslint": {
      "command": ["nr", "lint", "--fix", "$FILE"],
      "environment": {
        "NODE_ENV": "development"
      },
      "extensions": [".js", ".ts", ".jsx", ".vue", ".json", ".md"]
    }
  }
}
