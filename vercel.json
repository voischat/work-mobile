{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "rewrites": [
    {
      "source": "/v1/:match*",
      "destination": "https://demo.weila.hk/v1/:match*"
    },
    {
      "source": "/v2/:match*",
      "destination": "https://voiswork.cn/v2/:match*"
    }
  ]
}
