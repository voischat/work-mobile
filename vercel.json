{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/v1/:match*",
      "destination": "https://demo.weila.hk/v1/:match*"
    },
    {
      "source": "/v2/:match*",
      "destination": "https://www.voiswork.cn/v2/:match*"
    }
  ],
  "cleanUrls": true
}
