{
  "name": "weila-work-webview",
  "type": "module",
  "version": "1.1.4",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:intl": "vite build --mode intl",
    "dev": "vite --host",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "debug:logs": "vois-webview-debug",
    "debug:tail": "node scripts/debug-events.mjs --follow",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks",
    "archive": "esno scripts/archive.ts",
    "release": "bumpp --tag 'v{version}' --commit 'chore: release v{version}'"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^1.0.28",
    "@ai-sdk/openai": "^2.0.32",
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@iconify/vue": "^5.0.0",
    "@pinia/colada": "^0.20.0",
    "@sentry/vue": "^10.36.0",
    "@vueuse/core": "v14.0.0-alpha.2",
    "@wl/network": "https://pkg.pr.new/kvoon3/wl-network/@weila/network@f7937c34febd99f138eb6cd1e856b2e9800a27c5",
    "ai": "^5.0.92",
    "md5": "^2.3.0",
    "motion-v": "^1.7.6",
    "nanoid": "^5.1.6",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.4",
    "react-grab": "^0.0.39",
    "reka-ui": "^2.6.0",
    "unstorage": "^1.17.3",
    "vue": "^3.5.16",
    "vue-i18n": "^11.2.8",
    "vue-router": "4",
    "weila-auth": "^0.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.14.1",
    "@antfu/ni": "^27.0.1",
    "@antfu/utils": "^9.3.0",
    "@iconify-json/carbon": "^1.2.9",
    "@intlify/eslint-plugin-vue-i18n": "^4.1.1",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@kvoon/utils": "^0.3.1",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.15.31",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-macros/volar": "^3.0.0-beta.14",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/router": "14.0.0-alpha.0",
    "autoprefixer": "^10.4.20",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^9.28.0",
    "eslint-plugin-format": "^1.0.1",
    "esno": "^4.8.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.0",
    "postcss": "^8.4.47",
    "simple-git-hooks": "^2.13.0",
    "tailwindcss": "~3.4.17",
    "taze": "^19.1.0",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "unplugin-vue-macros": "^2.14.5",
    "unplugin-vue-router": "^0.12.0",
    "vite": "^6.3.5",
    "vite-plugin-vois-webview-debug": "0.1.0",
    "vitest": "^3.2.3",
